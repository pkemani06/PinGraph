# Postgres
POSTGRES_USER=pingraph
POSTGRES_PASSWORD=pingraph
POSTGRES_DB=pingraph
# Host port is 5433 because 5432 is taken by a local postgres.
# Inside the compose network (Phase 6) the API uses POSTGRES_HOST=postgres, POSTGRES_PORT=5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Identifies which API replica served a response (Phase 3+)
REPLICA_ID=local
